				memset(buffer, 0, sizeof(buffer));
				index_Var = 0; // Limpiar el indexado
				break;
				}
				keypress=gotKey();
				messageReady = readPad(keypress);
				}
				//Parte imaginaria
			while(1){
				keypress=gotKey();
				messageReady = readPad(keypress);
				if(messageReady == 1){ // termina parte real
					imag = strtod(buffer, &endptr);
					memset(buffer, 0, sizeof(buffer));
					index_Var = 0; // Limpiar el indexado
					break;
					}
				}
				//Meterlos numeros a la matriz
				if(rowMat < matSize)
					A[colMat][rowMat] = (cplx){real,imag};
				if(rowMat == matSize)
					b[rowMat]= (cplx){real,imag};
				real = 0;
				imag = 0;
				level = 1;
						break;

	case 2:
			// Resuelves la matriz
			messageReady = 0;
			int jaloone = solve_complex_system(matSize, A, b, x);
			//Imprimes la matriz
			//ST7735_WriteString(0, 0, "yawe:", Font_7x10, ST7735_WHITE, ST7735_BLACK);
			// Esperar mensaje de control
			while(!(messageReady)){
				keypress=gotKey();
				messageReady = readPad(keypress);
			}
			memset(buffer, 0, sizeof(buffer));
      break;
      }
		}
 }



uint8_t readPad(char *keypress){

  if(*keypress == 'F')
    return 0;

  switch (*keypress){
    case '=':
			if(level<2)
        		level++;
			if(level == 2)
				level--;
      return 1;
		// Caso para anterior pantalla
    case 'T':
      if(level>0)
        level--;
			memset(buffer, 0, sizeof(buffer));
      return 1;
		// Caso de borrar
		case 'D':
			if(index_Var > 0){
				buffer[index_Var] = 0;
				index_Var--;
			}
			break;

		// Caso de presion de numero o punto
    default:
		if (!(( (*keypress >= '0') && (*keypress <= '9') ) || *keypress == '.'))
				break;

      if((index_Var < BUFFER_SIZE))
        buffer[index_Var] = *keypress;
				index_Var++;
				break;
    }
	return 0;
}
