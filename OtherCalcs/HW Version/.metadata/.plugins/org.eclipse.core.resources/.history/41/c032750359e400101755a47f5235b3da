        }
        break;

    case 1:
        if(needsRedraw) {
            drawLevel1(colMat, rowMat, editingReal);
            needsRedraw = 0;
        }
        
        keypress = gotKey();
        messageReady = readPad(keypress);
        
		// Si se presionó una tecla pero no es un mensaje completo
		if(messageReady == 2) {
			// Buffer cambió (se agregó/borró un dígito)
			needsRedraw = 1;
			break;
		}
		
		
		// Si no hay nada en el buffer, permitir navegación
        if(index_Var == 0) {
            switch (*keypress){
                case 'W':
                    if(colMat > 0) colMat--;
                    needsRedraw = 1;
                    break;
                case 'B':
                    if(colMat < matSize - 1) colMat++;
                    needsRedraw = 1;
                    break;
                case 'L':
                    if(rowMat > 0) rowMat--;
                    needsRedraw = 1;
                    break;
                case 'R':
                    if(rowMat < matSize) rowMat++;
                    needsRedraw = 1;
                    break;
            }
            break;
        }
        
        // Si hay mensaje (se presionó un número o tecla especial)
        if(messageReady == 1) {
            if(*keypress == 'I' && editingReal) {
                // Termina ingreso de parte real
                real = strtod(buffer, &endptr);
                memset(buffer, 0, sizeof(buffer));
                index_Var = 0;
                editingReal = 0;
                needsRedraw = 1;} 
			else if(*keypress == '=') {
                // Termina ingreso completo
                if(editingReal) {
                    real = strtod(buffer, &endptr);
                    imag = 0.0;
                } else {
                    imag = strtod(buffer, &endptr);
                
				}
                
                // Guardar en matriz
                if(rowMat < matSize) {
                    A[colMat][rowMat] = (cplx){real, imag};
                } else {
                    b[colMat] = (cplx){real, imag};
                }
                
                // Reset y avanzar
                memset(buffer, 0, sizeof(buffer));
                index_Var = 0;
                editingReal = 1;
                real = 0.0;
                imag = 0.0;
                
                // Avanzar a siguiente celda (por COLUMNAS primero)
				rowMat++;
				if(rowMat > matSize) {
					rowMat = 0;
					colMat++;
				}
				
				// Si terminamos, ir a resolver
				if(colMat >= matSize) {
					level = 2;
				}
				
				needsRedraw = 1;
        }}
        break;

    case 2:
        // Resolver el sistema
        int success = solve_complex_system(matSize, A, b, x);
        drawLevel2(success == 0);
        
        // Esperar tecla para volver
        messageReady = 0;
        while(!(messageReady)){
            keypress = gotKey();
            messageReady = readPad(keypress);
        }
        
        // Reset para nuevo sistema
        level = 0;
        memset(buffer, 0, sizeof(buffer));
        index_Var = 0;
        needsRedraw = 1;
        break;

		}
 }}



uint8_t readPad(char *keypress){

  if(keypress == 0x27)
    return 0;

  switch (*keypress){
    case '=':
		if(level<2)
			level++;
		if(level == 2)
			level--;
		return 1;
		// Caso para anterior pantalla
    case 'T':
		if(level>0)
        	level--;
		memset(buffer, 0, sizeof(buffer));
		index_Var = 0;
      	return 1;
		
	// Caso de borrar
	case 'D':
		if(index_Var > 0){
			index_Var--;
			buffer[index_Var] = 0;
			}
		return 2;
	case 'I':
		return 1;
		
		// Caso de presion de numero o punto
    default:
		if (!(( (*keypress >= '0') && (*keypress <= '9') ) || *keypress == '.'))
		return 0;

		if((index_Var < BUFFER_SIZE)){
        buffer[index_Var] = *keypress;
		index_Var++;

		}
		return 2;
    }
	return 0;
}
